<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Vibrant diagonal gradient: indigo → magenta → coral -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#6366F1" />
                <item android:offset="0.45" android:color="#A855F7" />
                <item android:offset="0.8" android:color="#EC4899" />
                <item android:offset="1.0" android:color="#F97316" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft radial highlight in the upper-left for depth -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="30"
                android:centerY="26"
                android:gradientRadius="80"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>

    <!-- Subtle bottom-right shadow for dimension -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="86"
                android:centerY="90"
                android:gradientRadius="70"
                android:startColor="#33000000"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>
</vector>
