<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Page drop shadow -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.45"
        android:pathData="M32,28 Q32,24 36,24 L66,24 L84,42 L84,82 Q84,86 80,86 L36,86 Q32,86 32,82 Z" />

    <!-- Folded top-right corner: darker orange triangle underneath the page -->
    <path
        android:fillColor="#7C2D12"
        android:pathData="M64,22 L82,40 L64,40 Z" />

    <!-- Main page with orange gradient and folded corner cut-out -->
    <path android:pathData="M30,26 Q30,22 34,22 L64,22 L82,40 L82,80 Q82,84 78,84 L34,84 Q30,84 30,80 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="22"
                android:endX="82"
                android:endY="84">
                <item android:offset="0.0" android:color="#FDBA74" />
                <item android:offset="0.55" android:color="#FB923C" />
                <item android:offset="1.0" android:color="#F97316" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Crease line along the fold edge for depth -->
    <path
        android:strokeColor="#7C2D12"
        android:strokeAlpha="0.6"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M64,22 L82,40" />

    <!-- Soft highlight stripe along the top-left edge -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.22"
        android:pathData="M34,22 L62,22 L62,24.5 L32.5,24.5 Q32.5,23.5 34,22 Z" />

    <!-- Subtle "title underline" (first journal line) -->
    <path
        android:strokeColor="#431407"
        android:strokeAlpha="0.35"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M38,36 L58,36" />

    <!-- HERO: Bold black ECG pulse wave across the journal page -->
    <path
        android:strokeColor="#0C0A09"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M36,54 L42,54 L46,44 L50,68 L54,34 L58,64 L62,50 L66,54 L76,54" />

    <!-- Tiny accent dot marking a heartbeat peak (AI-detected highlight) -->
    <path
        android:fillColor="#F97316"
        android:pathData="M54,34 m-2.6,0 a2.6,2.6 0,1 1,5.2 0 a2.6,2.6 0,1 1,-5.2 0" />
    <path
        android:fillColor="#000000"
        android:pathData="M54,34 m-1.2,0 a1.2,1.2 0,1 1,2.4 0 a1.2,1.2 0,1 1,-2.4 0" />

    <!-- Faint "journal entry lines" beneath the pulse -->
    <path
        android:strokeColor="#431407"
        android:strokeAlpha="0.3"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M38,72 L74,72" />
    <path
        android:strokeColor="#431407"
        android:strokeAlpha="0.3"
        android:strokeWidth="1.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M38,78 L66,78" />
</vector>
