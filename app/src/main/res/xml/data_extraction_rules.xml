<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+).

    HealthJournal stores sensitive personal health information (symptoms,
    vitals, medications, doctor contacts). We do NOT want Google's automatic
    Cloud Backup or Device-to-Device transfer to include this data: users
    must export it manually via the in-app SAF ZIP export flow so they
    remain in control of where their health records travel.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
